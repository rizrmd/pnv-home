<script>
  // Keep .glitch data-text in sync
  document.querySelectorAll('.glitch').forEach(el => {
    const update = () => el.setAttribute('data-text', el.textContent.trim());
    update();
    new MutationObserver(update).observe(el, {childList:true,characterData:true,subtree:true});
  });

  // FAQ accordion
  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-q').addEventListener('click', () => {
      const open = item.classList.contains('open');
      item.classList.toggle('open');
      item.querySelector('.faq-icn').textContent = open ? '+' : '−';
    });
  });

  // Sync browser mock aspect ratio to video dimensions
  (function(){
    const vid = document.querySelector('.browser-mock-body video');
    const body = document.querySelector('.browser-mock-body');
    if (!vid || !body) return;
    function apply(){
      if (vid.videoWidth && vid.videoHeight){
        body.style.aspectRatio = vid.videoWidth + ' / ' + vid.videoHeight;
      }
    }
    if (vid.readyState >= 1) apply();
    vid.addEventListener('loadedmetadata', apply, {once:true});
  })();
</script>

</body>
</html>
