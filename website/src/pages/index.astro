---
// pnv marketing landing page
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>pnv — Automate X, Threads, Instagram and TikTok. No code. No AI.</title>
<meta name="description" content="pnv records what you do on social media and replays it exactly — every time. Post, engage, and grow on autopilot. No code. No AI. No surprises." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

<style is:global>
  :root{
    --bg:#ffffff;
    --bg-2:#f6f6f7;
    --bg-card:#ffffff;
    --bg-card-hover:#fafafa;
    --ink:#0a0a0a;
    --ink-70:#525258;
    --ink-30:#9a9aa1;
    --border:rgba(10,10,10,0.08);
    --border-strong:rgba(10,10,10,0.14);
    --accent:#0891b2;
    --accent-bright:#06b6d4;
    --accent-dim:rgba(8,145,178,0.08);
    --accent-border:rgba(8,145,178,0.28);
    --accent-glow:rgba(8,145,178,0.22);
    --accent-on:#ffffff;
    --term-bg:#0c0c14;
    --term-bg-2:#101019;
    --term-ink:#e8e9ee;
    --term-ink-70:rgba(232,233,238,0.62);
    --term-ink-30:rgba(232,233,238,0.32);
    --term-border:rgba(232,233,238,0.08);
    --red:#dc2626;
    --green:#16a34a;
    --amber:#d97706;
    --grid-opacity:0.04;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);
    font-family:'Space Grotesk',ui-sans-serif,system-ui,-apple-system,sans-serif;
    font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden;text-wrap:pretty}
  ::selection{background:var(--accent);color:var(--accent-on)}
  a{color:inherit;text-decoration:none}
  img{display:block;max-width:100%}
  .container{width:100%;max-width:1240px;margin:0 auto;padding:0 32px}
  .mono{font-family:'JetBrains Mono',ui-monospace,monospace}

  /* ── nav ── */
  nav.top{position:sticky;top:0;z-index:50;backdrop-filter:blur(14px);
    background:rgba(255,255,255,0.78);border-bottom:1px solid var(--border)}
  nav.top .wrap{display:flex;align-items:center;justify-content:space-between;padding:14px 0}
  .brand{display:flex;align-items:center;gap:10px;font-weight:700;letter-spacing:-0.02em;color:var(--ink)}
  .brand .logo{width:140px;height:60px;
    background:url(/assets/logo-pnv.png) left center/contain no-repeat}
  .sys{display:flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.18em;
    color:var(--ink-70);text-transform:uppercase}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--green);
    box-shadow:0 0 8px rgba(22,163,74,0.5);animation:blink 1.8s ease-in-out infinite}
  @keyframes blink{0%,100%{opacity:.4}50%{opacity:1}}
  .nav-links{display:flex;gap:28px;font-size:14px;color:var(--ink-70)}
  .nav-links a:hover{color:var(--accent)}
  .nav-right{display:flex;align-items:center;gap:24px}

  /* ── buttons ── */
  .btn{display:inline-flex;align-items:center;gap:10px;font-weight:600;font-size:14px;
    letter-spacing:.01em;padding:14px 28px;cursor:pointer;border:0;
    border-radius:10px;transition:all .2s ease;font-family:inherit}
  .btn-primary{background:var(--ink);color:#ffffff}
  .btn-primary:hover{background:var(--accent);transform:translateY(-1px);
    box-shadow:0 8px 30px var(--accent-glow)}
  .btn-ghost{background:transparent;color:var(--ink);
    box-shadow:inset 0 0 0 1px var(--border-strong)}
  .btn-ghost:hover{color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
  .btn-sm{padding:10px 20px;font-size:13px}
  .btn .arr{transition:transform .2s ease}
  .btn:hover .arr{transform:translateX(3px)}

  /* ── section label ── */
  .slabel{display:inline-flex;align-items:center;gap:14px;color:var(--accent);
    font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.22em;
    text-transform:uppercase;font-weight:500}
  .slabel::before{content:"";width:28px;height:1px;background:var(--accent)}

  /* ── grid bg ── */
  .grid-bg{position:absolute;inset:0;pointer-events:none;
    background-image:linear-gradient(to right,var(--ink) 1px,transparent 1px),
      linear-gradient(to bottom,var(--ink) 1px,transparent 1px);
    background-size:48px 48px;opacity:var(--grid-opacity);
    mask-image:radial-gradient(ellipse at 50% 0%,#000 0%,transparent 70%)}

  /* ── sections ── */
  section{padding:96px 0;position:relative}
  h2.sec-h{font-size:clamp(26px,3.8vw,48px);font-weight:700;letter-spacing:-0.03em;
    line-height:1.05;margin:18px 0 0;max-width:880px;color:var(--ink)}
  .sec-sub{color:var(--ink-70);max-width:640px;margin-top:18px;font-size:17px}

  /* ── grid card pattern ── */
  .gx{display:grid;gap:1px;background:var(--border);margin-top:56px;border:1px solid var(--border)}
  .gx-3{grid-template-columns:repeat(3,1fr)}
  .gx-2{grid-template-columns:1fr 1fr}
  .card{background:var(--bg-card);padding:36px 32px;transition:background .25s ease}
  .card:hover{background:var(--bg-card-hover)}
  .card .icn{width:38px;height:38px;display:flex;align-items:center;justify-content:center;
    color:var(--accent);margin-bottom:24px}
  .card h3{font-size:18px;font-weight:600;margin:0 0 10px;letter-spacing:-0.01em;color:var(--ink)}
  .card p{color:var(--ink-70);font-size:14.5px;margin:0;line-height:1.6}
  .card .label{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.22em;
    text-transform:uppercase;color:var(--ink-30);margin-bottom:18px}

  /* ── steps ── */
  .steps{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:32px;margin-top:64px}
  .steps::before{content:"";position:absolute;top:22px;left:5%;right:5%;height:1px;
    background:linear-gradient(90deg,transparent,var(--accent-border),transparent);z-index:0}
  .step{position:relative;z-index:1}
  .step .num{width:44px;height:44px;border:1px solid var(--accent);color:var(--accent);
    background:var(--bg);display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:700;margin-bottom:22px}
  .step h3{font-size:17px;font-weight:600;margin:0 0 8px;letter-spacing:-0.01em;color:var(--ink)}
  .step p{font-size:14px;color:var(--ink-70);margin:0}

  /* ── pricing ── */
  .price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;
    background:var(--border);border:1px solid var(--border);margin-top:56px}
  .tier{background:var(--bg-card);padding:40px 32px;position:relative}
  .tier.featured{background:#0c0c14;color:#fff}
  .tier.featured h3,.tier.featured .name,.tier.featured .price b{color:#fff}
  .tier.featured .lede,.tier.featured li{color:rgba(255,255,255,0.72)}
  .tier.featured .price span{color:rgba(255,255,255,0.4)}
  .tier.featured .btn-primary{background:var(--accent);color:#fff}
  .tier.featured .btn-primary:hover{background:var(--accent-bright)}
  .tier.featured::before{content:"RECOMMENDED";position:absolute;top:-10px;left:32px;
    background:var(--accent);color:#fff;font-family:'JetBrains Mono',monospace;
    font-size:10px;letter-spacing:.22em;padding:3px 10px}
  .tier .name{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.22em;
    text-transform:uppercase;color:var(--ink-30)}
  .tier .price{display:flex;align-items:baseline;gap:6px;margin:18px 0 6px}
  .tier .price b{font-size:48px;font-weight:700;letter-spacing:-0.03em;color:var(--ink)}
  .tier .price span{color:var(--ink-30);font-size:13px;font-family:'JetBrains Mono',monospace}
  .tier .lede{color:var(--ink-70);font-size:14px;margin:0 0 24px;min-height:42px}
  .tier ul{list-style:none;padding:0;margin:24px 0 28px;display:flex;flex-direction:column;gap:10px}
  .tier li{display:flex;gap:10px;font-size:14px;color:var(--ink-70);align-items:flex-start}
  .tier li svg{flex:none;margin-top:5px;color:var(--accent)}
  .tier .btn{width:100%;justify-content:center}

  /* ── faq ── */
  .faq-list{margin-top:48px;border-top:1px solid var(--border)}
  .faq-item{border-bottom:1px solid var(--border)}
  .faq-q{display:flex;align-items:center;justify-content:space-between;
    padding:22px 0;cursor:pointer;font-size:17px;font-weight:500;letter-spacing:-0.01em;color:var(--ink)}
  .faq-icn{width:24px;height:24px;border:1px solid var(--accent-border);color:var(--accent);
    display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;
    transition:all .25s ease;flex:none;margin-left:24px}
  .faq-item.open .faq-icn{background:var(--accent);color:#fff;border-color:var(--accent)}
  .faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease;color:var(--ink-70);font-size:15px}
  .faq-a-inner{padding:0 0 24px;max-width:760px}
  .faq-item.open .faq-a{max-height:400px}

  /* ── closing cta ── */
  .cta-wrap{position:relative;margin:80px 0 120px;padding:96px 32px;
    background:#0c0c14;color:#fff;border:1px solid var(--border);text-align:center;overflow:hidden}
  .cta-wrap .grid-bg{background-image:
    linear-gradient(to right,#fff 1px,transparent 1px),
    linear-gradient(to bottom,#fff 1px,transparent 1px);opacity:.05}
  .cta-wrap::after{content:"";position:absolute;inset:auto 0 -50% 0;height:300px;
    background:radial-gradient(ellipse at 50% 100%,var(--accent-glow),transparent 60%);
    pointer-events:none;opacity:.8}
  .cta-wrap .slabel{color:var(--accent-bright)}
  .cta-wrap .slabel::before{background:var(--accent-bright)}
  .cta-wrap h2{font-size:clamp(28px,4.5vw,56px);font-weight:700;letter-spacing:-0.035em;
    margin:18px 0 30px;max-width:780px;margin-left:auto;margin-right:auto;line-height:1.05;
    position:relative;z-index:1;color:#fff}
  .cta-wrap .hero-ctas{position:relative;z-index:1}
  .cta-wrap .btn-primary{background:var(--accent);color:#fff}
  .cta-wrap .btn-primary:hover{background:var(--accent-bright)}
  .cta-wrap .btn-ghost{color:#fff;box-shadow:inset 0 0 0 1px rgba(255,255,255,0.3)}
  .cta-wrap .btn-ghost:hover{color:var(--accent-bright);box-shadow:inset 0 0 0 1px var(--accent-bright)}

  /* ── footer ── */
  footer{padding:48px 0 64px;border-top:1px solid var(--border)}
  footer .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px}
  footer .left{display:flex;align-items:center;gap:18px;color:var(--ink-30);font-size:13px}
  footer .left b{color:var(--ink);font-weight:600}
  footer .links{display:flex;gap:24px;font-size:13px;color:var(--ink-70)}
  footer .links a:hover{color:var(--accent)}
  footer .built{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.14em;
    color:var(--ink-30);text-transform:uppercase}

  /* ── glitch ── */
  .glitch{position:relative;display:inline-block}
  .glitch::before,.glitch::after{content:attr(data-text);position:absolute;inset:0;pointer-events:none;opacity:0}
  .glitch::before{color:var(--accent);
    clip-path:polygon(0 0,100% 0,100% 40%,0 40%);animation:glitch-a 6s infinite}
  .glitch::after{color:#ec4899;
    clip-path:polygon(0 60%,100% 60%,100% 100%,0 100%);animation:glitch-b 6s infinite}
  @keyframes glitch-a{
    0%,87%,100%{opacity:0;transform:translate(0,0)}
    88%{opacity:.7;transform:translate(-2px,0)}90%{opacity:0}
    93%{opacity:.55;transform:translate(2px,-1px)}95%{opacity:0}}
  @keyframes glitch-b{
    0%,87%,100%{opacity:0;transform:translate(0,0)}
    88%{opacity:.7;transform:translate(2px,0)}91%{opacity:0}
    94%{opacity:.55;transform:translate(-2px,1px)}96%{opacity:0}}
  @media (prefers-reduced-motion:reduce){
    .glitch::before,.glitch::after{display:none}
    .dot,.rec-dot{animation:none!important}}

  /* ── responsive (base) ── */
  @media (max-width:960px){
    .container{padding:0 20px}
    section{padding:64px 0}
    .nav-links,.sys{display:none}
    .gx-3,.price-grid{grid-template-columns:1fr}
    .steps{grid-template-columns:1fr 1fr;gap:32px}
    .steps::before{display:none}
    footer .wrap{flex-direction:column;text-align:center}
    .hero-ctas{flex-direction:column;align-items:stretch}
    .hero-ctas .btn{justify-content:center}
  }

  /* ── hero v2 ── */
  .hero-v2{position:relative;padding:64px 0 96px;overflow:hidden}
  .hero-v2 .grid-bg{opacity:calc(var(--grid-opacity) * 0.6)}
  .hero-v2 .container{max-width:1380px}
  .hero-grid{position:relative;display:grid;
    grid-template-columns:minmax(320px,0.85fr) minmax(0,1.5fr);
    gap:64px;align-items:center;min-height:540px}
  .hero-copy{text-align:left;max-width:480px;justify-self:start}
  .hero-mock{justify-self:end;width:100%;max-width:900px}
  @media (max-width:1100px){
    .hero-grid{grid-template-columns:1fr;gap:48px}
    .hero-copy{justify-self:center;text-align:center;max-width:640px}
    .hero-mock{justify-self:center}
  }
  .hero-copy h1{font-size:clamp(30px,3.2vw,50px);font-weight:700;letter-spacing:-0.035em;
    line-height:1.04;margin:0;color:var(--ink)}
  .hero-copy .h1-muted{display:block;color:var(--ink-30);margin-top:6px}
  .hero-copy .hero-desc{font-size:16px;color:var(--ink-70);margin:22px 0 0;max-width:420px;line-height:1.55}
  .hero-ctas{display:flex;gap:14px;justify-content:flex-start;flex-wrap:wrap;margin-top:32px}
  @media (max-width:1100px){.hero-ctas{justify-content:center}}

  /* ── browser mock ── */
  .hero-mock{position:relative;width:100%;display:flex;flex-direction:column;gap:14px}
  .browser-mock{position:relative;width:100%;
    background:#fff;border:1px solid rgba(10,10,10,0.08);
    border-radius:14px;overflow:hidden;
    box-shadow:0 30px 60px rgba(10,10,10,0.12),0 8px 20px rgba(10,10,10,0.06)}
  .browser-mock-bar{display:flex;align-items:center;gap:10px;padding:11px 14px;
    border-bottom:1px solid var(--border)}
  .browser-mock-bar .dots{display:flex;gap:5px}
  .browser-mock-bar .dots i{width:9px;height:9px;border-radius:50%;background:rgba(10,10,10,0.18)}
  .browser-mock-bar .dots i:nth-child(1){background:#ff5f57}
  .browser-mock-bar .dots i:nth-child(2){background:#febc2e}
  .browser-mock-bar .dots i:nth-child(3){background:#28c840}
  .browser-mock-url{flex:1;max-width:380px;margin:0 auto;padding:6px 12px;
    background:#f4f4f7;color:var(--ink-30);font-size:11px;border-radius:6px;
    font-family:'JetBrains Mono',monospace;display:flex;align-items:center;gap:8px}
  .browser-mock-url svg{width:11px;height:11px;flex:none;color:var(--ink-30)}
  .prod-url-host{color:var(--ink)}
  .prod-url-path{color:var(--ink-30)}
  .browser-mock-body{position:relative;flex:1;background:#fff;aspect-ratio:1916/897}
  video.prod-img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block}

  /* ── recording pill ── */
  .rec-pill{display:inline-flex;align-items:center;gap:8px;
    padding:7px 14px;background:#fff;color:var(--ink);font-size:12px;
    border:1px solid rgba(10,10,10,0.1);border-radius:999px;
    font-family:'JetBrains Mono',monospace;box-shadow:0 6px 18px rgba(10,10,10,0.08);
    font-weight:500;z-index:2}
  .rec-pill .rec-dot{width:8px;height:8px;border-radius:50%;background:#ef4444;
    box-shadow:0 0 8px rgba(239,68,68,0.5);animation:blink 1.2s ease-in-out infinite}
  .rec-pill-tabbed{position:absolute;top:-22px;right:32px}
  .hero-glow{position:absolute;left:50%;bottom:-30px;transform:translateX(-50%);
    width:80%;height:80px;background:radial-gradient(ellipse at center,var(--accent-glow),transparent 70%);
    filter:blur(20px);opacity:.6;pointer-events:none;z-index:-1}

  /* ── trusted by ── */
  .trusted{padding:48px 0 24px;text-align:center}
  .trusted-label{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.24em;
    text-transform:uppercase;color:var(--ink-30);margin-bottom:24px}
  .trusted-row{display:flex;justify-content:space-around;align-items:center;flex-wrap:wrap;gap:32px}
  .trusted-logo{display:inline-flex;align-items:center;gap:10px;color:var(--ink-30);
    font-size:22px;font-weight:600;letter-spacing:-0.02em;transition:color .2s ease}
  .trusted-logo:hover{color:var(--ink)}
  .trusted-logo svg{width:22px;height:22px}

  /* ── behave ── */
  .behave{padding:80px 0}
  .behave-card{background:var(--bg-2);border:1px solid var(--border);border-radius:24px;
    padding:64px 56px;display:grid;grid-template-columns:1fr 1.4fr;gap:64px;align-items:center}
  .behave-card h2{font-size:clamp(28px,3.4vw,42px);font-weight:700;letter-spacing:-0.03em;
    line-height:1.05;margin:0 0 18px;color:var(--ink)}
  .behave-card p{color:var(--ink-70);font-size:15px;margin:0;max-width:340px}
  .behave-steps{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .behave-steps::before{content:"";position:absolute;top:60px;left:14%;right:14%;height:1px;
    background:var(--border-strong);z-index:0}
  .behave-step{position:relative;z-index:1;text-align:left;padding:0}
  .behave-step-icn{width:120px;height:120px;background:var(--bg-card);border:1px solid var(--border);
    border-radius:18px;display:flex;align-items:center;justify-content:center;
    margin-bottom:20px;color:var(--ink);box-shadow:0 6px 18px rgba(10,10,10,0.04)}
  .behave-step-icn svg{width:44px;height:44px}
  .behave-step h3{font-size:18px;font-weight:600;margin:0 0 8px;letter-spacing:-0.01em;color:var(--ink)}
  .behave-step p{font-size:13.5px;color:var(--ink-70);margin:0;max-width:180px;line-height:1.5}
  @media (max-width:960px){
    .behave-card{grid-template-columns:1fr;padding:40px 32px;gap:40px}
    .behave-steps{grid-template-columns:1fr}
    .behave-steps::before{display:none}
  }

  /* ── matters / use cases ── */
  .matters{padding:80px 0}
  .matters-grid{display:grid;grid-template-columns:1fr 1.1fr 1fr;gap:48px;align-items:start}
  .matters-copy h2{font-size:clamp(28px,3.4vw,42px);font-weight:700;letter-spacing:-0.03em;
    line-height:1.05;margin:0 0 16px;color:var(--ink)}
  .matters-copy p{color:var(--ink-70);font-size:15px;margin:0 0 28px;max-width:300px}
  .matters-copy .btn{padding:10px 18px;font-size:13px;border-radius:999px;
    background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1px var(--border-strong)}
  .matters-copy .btn:hover{color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
  .use-list{display:flex;flex-direction:column;gap:10px}
  .use-list-item{display:flex;align-items:flex-start;gap:14px;padding:18px 20px;
    background:var(--bg-card);border:1px solid var(--border);border-radius:12px;
    transition:background .2s ease}
  .use-list-item:hover{background:var(--bg-card-hover)}
  .use-list-icn{flex:none;width:32px;height:32px;display:flex;align-items:center;justify-content:center;color:var(--ink-70)}
  .use-list-icn svg{width:18px;height:18px}
  .use-list-item h3{font-size:14.5px;font-weight:600;margin:0 0 4px;letter-spacing:-0.005em;color:var(--ink)}
  .use-list-item p{font-size:12.5px;color:var(--ink-70);margin:0}
  .use-diagram{position:relative;aspect-ratio:1/1.05;background:var(--bg-2);
    border:1px solid var(--border);border-radius:16px;padding:24px;
    background-image:radial-gradient(circle at 1px 1px,var(--ink) 1px,transparent 1px);
    background-size:14px 14px;background-blend-mode:multiply}
  .use-diagram::before{content:"";position:absolute;inset:0;border-radius:16px;
    background:radial-gradient(ellipse at center,var(--bg-2) 30%,transparent 75%);pointer-events:none}
  .use-diagram-inner{position:relative;z-index:1;display:flex;flex-direction:column;
    align-items:center;justify-content:space-between;height:100%}
  .use-node{display:flex;align-items:center;justify-content:center;
    width:60px;height:60px;background:var(--bg-card);border:1px solid var(--border);
    border-radius:50%;color:var(--ink);box-shadow:0 4px 12px rgba(10,10,10,0.06)}
  .use-node svg{width:24px;height:24px}
  .use-node.center{width:auto;height:auto;border-radius:14px;padding:14px 22px;
