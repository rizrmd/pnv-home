    mix-blend-mode:multiply;pointer-events:none;z-index:1;opacity:.85}
  .zero-illu::after{content:"";position:absolute;inset:0;
    background:linear-gradient(180deg,transparent 60%,rgba(0,0,0,0.04));pointer-events:none;z-index:1}
